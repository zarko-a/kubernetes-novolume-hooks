{
  "name": "hooks",
  "version": "0.8.1",
  "description": "Container hooks for actions-runner-controller's kubernetes-novolume mode: k8s (the hook) and hooklib (shared types and utilities)",
  "main": "",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "npm run test --prefix packages/k8s",
    "bootstrap": "npm ci --ignore-scripts --prefix packages/hooklib && npm ci --ignore-scripts --prefix packages/k8s",
    "format": "prettier --write '**/*.ts'",
    "format-check": "prettier --check '**/*.ts'",
    "lint": "eslint packages/**/*.ts",
    "lint:fix": "eslint packages/**/*.ts --fix",
    "build-all": "npm run build --prefix packages/hooklib && npm run build --prefix packages/k8s"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zarko-a/kubernetes-novolume-hooks.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/zarko-a/kubernetes-novolume-hooks/issues"
  },
  "homepage": "https://github.com/zarko-a/kubernetes-novolume-hooks#readme",
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.14",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "eslint": "^9.31.0",
    "eslint-plugin-github": "^6.0.0",
    "globals": "^15.12.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "eslint-plugin-jest": "^29.0.1"
  }
}
