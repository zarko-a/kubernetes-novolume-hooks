{
  "name": "kubehooks",
  "version": "0.1.0",
  "description": "Container hook for actions-runner-controller's kubernetes-novolume mode: runs each job in its own pod",
  "main": "lib/index.js",
  "scripts": {
    "test": "jest --runInBand",
    "test:unit": "jest --ci --testPathIgnorePatterns '/tests/(cleanup-job|e2e|k8s-utils|prepare-job|run-container-step|run-script-step)-test\\.ts$'",
    "build": "tsc && npx ncc build",
    "format": "prettier --write '**/*.ts'",
    "format-check": "prettier --check '**/*.ts'",
    "lint": "eslint src/**/*.ts"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^2.0.2",
    "@kubernetes/client-node": "^1.3.0",
    "hooklib": "file:../hooklib",
    "js-yaml": "^5.0.0",
    "shlex": "^3.0.0",
    "tar-fs": "^3.1.2"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@vercel/ncc": "^0.44.0",
    "babel-jest": "^30.4.1",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zarko-a/kubernetes-novolume-hooks.git",
    "directory": "packages/k8s"
  },
  "bugs": {
    "url": "https://github.com/zarko-a/kubernetes-novolume-hooks/issues"
  },
  "homepage": "https://github.com/zarko-a/kubernetes-novolume-hooks#readme"
}
